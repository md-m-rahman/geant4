:volu world BOX 500*cm 500*cm 500*cm G4_Galactic
:vis world OFF
:rotm r000 0 0 0
:rotm r090y 90 0 0 0 90 90
:volu cryostat TUBE 5 5.5*cm 25*cm G4_Al
:volu stage BOX 2*cm .5*cm 2*cm G4_Au
:volu Cu_plate BOX 2*cm 0.25*cm 2*cm G4_Cu
:volu In_foil BOX 2*cm 0.05*cm 2*cm G4_In
:volu HPGe TUBE 0 1*cm 2*cm G4_Ge

:place cryostat 1 world r090y 0 0 0
:place stage 2 cryostat r000 0 -3.0625 0
:place Cu_plate 3 cryostat r000 0 -1.0625 0
:place In_foil 4 cryostat r000 0 -1.05 0
:place HPGe 5 cryostat r000 0 0 0
:color cryostat 0.5 0.5 0.5
:color stage 0 0 1
:color Cu_plate 1 0 0
:color In_foil 0 1 0
:color HPGe 0.5 0.5 0.5

