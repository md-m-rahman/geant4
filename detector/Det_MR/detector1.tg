:volu world BOX 500*cm 500*cm 500*cm G4_Galactic
:vis world OFF
:volu room BOX 50*cm 50*cm 50*cm G4_Galactic
:vis room OFF
:rotm r000 0 0 0
:rotm r90x 90 0 180 0 90 90
:rotm r15 90 15 180 0 90 105


:solid ge_main   TUBE 0 12.45*mm 4.1*mm 0 360*deg
:solid ge_hole   TUBE 0 6.15*mm 1.1*mm 0 360*deg
:solid ge_groove TUBE 10.45*mm 11.45*mm 0.5*mm 0 360*deg

:solid ge_step1 SUBTRACTION ge_main ge_hole 0 0 -3.0*mm
:solid ge_final SUBTRACTION ge_step1 ge_groove 0 0 3.6*mm

:place HPGe(S) 2 room r90x 0 -15*cm 0
:place HPGe(S) 3 room r15 3.882*cm -14.489*cm 0