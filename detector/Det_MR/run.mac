/control/verbose 0
/process/em/verbose 0
/process/had/verbose 0

/run/initialize
/geometry/test/run

#/vis/open VRML2FILE
/vis/open 
/vis/drawVolume
/vis/scene/add/axes 0 0 0 20 cm
/vis/viewer/set/style surface
#/vis/viewer/set/viewpointThetaPhi 0 0 deg
/vis/viewer/set/viewpointVector 0 0  0
#/vis/viewer/set/upVector 0 1 0
/vis/viewer/zoom 1
/vis/viewer/refresh



/gps/source/add 1
/gps/particle gamma
/gps/energy 662 keV
/gps/position 0 10 0 cm
/gps/direction 0 -1 0 


/vis/scene/add/trajectories 
/vis/scene/endOfEventAction accumulate
/run/beamOn 20
/vis/viewer/refresh


