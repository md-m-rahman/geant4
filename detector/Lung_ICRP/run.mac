/control/verbose 0
/process/em/verbose 0
/process/had/verbose 0

/run/initialize
/geometry/test/run

/vis/open 
/vis/drawVolume

/vis/scene/add/axes 0 0 0 50 cm
/vis/viewer/set/style surface

/vis/geometry/set/forceWireframe Phantom(S) 0 true
/vis/geometry/set/forceSolid LeftLung(S) 0 true
/vis/geometry/set/forceSolid RightLung(S) 0 true
/vis/geometry/set/forceSolid tumor(S) 0 true

/vis/viewer/set/viewpointVector 1 -1 1
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/targetPoint 0 0 0 cm
/vis/viewer/set/background white
/vis/viewer/flush


#/gps/source/add 1
/gps/particle gamma
/gps/energy 662 keV
/gps/position 0 40 0 cm
/gps/direction 0 -1 0
#/gps/ang/type iso
#/gps/ang/rot1 1 0 0
#/gps/ang/rot2 0 0 -1
#/gps/ang/mintheta 0 rad
#/gps/ang/maxtheta 0.2 rad

/vis/scene/add/axes 0 0 0 50 cm
/vis/scene/add/trajectories 
/vis/scene/endOfEventAction accumulate 1000
/vis/scene/add/trajectories smooth
#/vis/viewer/set/viewpointVector 0 0 0
/run/beamOn 1000
/vis/viewer/refresh
