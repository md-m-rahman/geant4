    "import ROOT\n",
    "# This enables the interactive graphics in Jupyter\n",
    "%jsroot on\n",
    "\n",
    "# Re-open the file and get the tree\n",
    "f = ROOT.TFile.Open(\"tumor.root\")\n",
    "t = f.Get(\"t\")\n",
    "\n",
    "# Now this will work\n",
    "t.Draw(\"et\", \"vlm==3\")"
