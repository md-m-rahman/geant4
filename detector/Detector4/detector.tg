:volu HPGe(S) TUBE 0 3*cm 2*cm G4_Ge
:volu In_foil BOX 3*cm 0.05*cm 3*cm G4_In
:volu Cu_plate BOX 3*cm 0.25*cm 3*cm G4_Cu
:volu stage BOX 3*cm 0.5*cm 3*cm G4_Au

:place room 1 world r000 0 0 0
:place Phantom(S) 2 room r000 0 9*cm 0
:place tumor(S) 3 Phantom(S) r000 0 0 0
:vis tumor(S) ON
:vis Phantom(S) ON

:place cryostat 4 room r000 0 0 0
:place cryo_vacuum 5 room r000 0 0 0
:place HPGe(S) 6 cryo_vacuum r90x 0 0 0
:place In_foil 7 cryo_vacuum r000 0 -2.0500005*cm 0
:place Cu_plate 8 cryo_vacuum r000 0 -2.350001*cm 0
:place stage 9 cryo_vacuum r000 0 -3.1000010*cm 0
:color HPGe(S) 1 1 0
:color In_foil 0 0 1
:color Cu_plate 1 0 0
:color stage 0.5 0.5 0.5
