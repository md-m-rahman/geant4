/control/verbose 0
/process/em/verbose 0
/process/had/verbose 0

/run/initialize
/geometry/test/run

/vis/open 
/vis/drawVolume
/vis/scene/add/axes 0 0 0 10 cm
/vis/viewer/set/viewpointVector 1 1 1
/vis/viewer/flush

/gps/source/add 1
/gps/particle mu+
/gps/ang/type iso
/gps/energy 4 GeV
/gps/position 0 100 0 cm
#/gps/direction 0 -1 0

/vis/scene/add/trajectories 
/vis/scene/endOfEventAction accumulate
/vis/viewer/set/viewpointVector 1 1 1
/run/beamOn 50
/vis/viewer/refresh