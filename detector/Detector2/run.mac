/control/verbose 0
/process/em/verbose 1
/process/had/verbose 0

/run/initialize
/geometry/test/run
/process/list

# Turn off 'msc' (Multiple Scattering) for electrons to see "sharp" tracks
#/process/inactivate msc e-

# Turn off 'eIoni' (Ionization) to stop energy deposition from e-
#/process/inactivate eIoni e-

/vis/open 
/vis/drawVolume
/vis/scene/add/axes 0 0 0 10 cm
/vis/viewer/refresh

/gps/particle alpha
/gps/energy 5 MeV
/gps/position 0 0 3 cm
/gps/direction 0 0 1

/vis/scene/add/trajectories
/vis/scene/endOfEventAction accumulate
/vis/viewer/set/viewpointVector 1 1 1
/run/beamOn 5
/vis/viewer/flush

