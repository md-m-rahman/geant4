:volu world BOX 500*cm 500*cm 500*cm G4_Galactic
:vis world OFF
:volu room BOX 50*cm 50*cm 50*cm G4_Galactic
:vis room OFF
:rotm r000 0 0 0
:rotm r90x 90 0 0 0 90 90
:volu cryostat TUBE 3.5*cm 3.75*cm 5*cm G4_Galactic
:vis cryostat OFF
:volu cryo_vacuum TUBE 0 3.4*cm 4.9*cm G4_Galactic
:vis cryo_vacuum OFF
:volu HPGe TUBE 0 .75*cm .4*cm G4_Ge
:volu In_foil BOX 2*cm 0.05*cm 2*cm G4_In
:volu Cu_plate BOX 2*cm 0.25*cm 2*cm G4_Cu
:volu stage BOX 2*cm 0.5*cm 2*cm G4_Au
:mixt_by_natoms sugar 1.05 3
  C 12
  H 360
  O 180
:volu drop SPHERE 0 0.5*cm 0 180 0 90 sugar

:place room 1 world r000 0 0 0
:place cryostat 2 room r000 0 0 0
:place cryo_vacuum 3 room r000 0 0 0
:place HPGe  4 cryo_vacuum  r90x 0 0 0
:place In_foil 5 cryo_vacuum r000 0 -.4500005*cm 0
:place Cu_plate 6 cryo_vacuum r000 0 -.750001*cm 0
:place stage 7 cryo_vacuum r000 0 -1.5000015*cm 0
:place drop 8 room r000 0 3.7500005*cm 0

:color drop 1.0 0.5 0.31
:color HPGe 1 1 0
:color In_foil 0 0 1
:color Cu_plate 1 0 0
:color stage 0.5 0.5 0.5
